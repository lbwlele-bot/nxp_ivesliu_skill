#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
from typing import Any

import yaml


SCHEMA_VERSION = 1
IDENTITY_FIELDS = (
    "soc",
    "silicon_revision",
    "chip_package",
    "board",
    "ddr",
    "software_release",
)
IDENTITY_LABELS = {
    "soc": "SoC",
    "silicon_revision": "Silicon revision",
    "chip_package": "芯片封装",
    "board": "目标板",
    "ddr": "DDR",
    "software_release": "软件版本",
}
UNKNOWN_VALUES = {"unknown", "tbd", "todo", "?"}
NOT_APPLICABLE_VALUES = {"n/a", "na", "not applicable", "not_applicable"}
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


class RequestError(ValueError):
    pass


def text_value(value: Any, label: str) -> str:
    if not isinstance(value, str):
        raise RequestError(f"{label} must be a string")
    value = value.strip()
    if not value:
        raise RequestError(f"{label} must not be empty")
    return value


def mapping_value(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RequestError(f"{label} must be a mapping")
    return value


def reject_unknown_keys(data: dict[str, Any], allowed: set[str], label: str) -> None:
    unknown = sorted(set(data) - allowed)
    if unknown:
        raise RequestError(f"{label} has unsupported fields: {', '.join(unknown)}")


def normalized_marker(value: str) -> str:
    return " ".join(value.strip().lower().split())


def normalize_request(data: Any) -> dict[str, Any]:
    root = mapping_value(data, "request")
    reject_unknown_keys(
        root,
        {
            "schema_version",
            "case",
            "identity",
            "identity_notes",
            "identity_effects",
            "compile",
        },
        "request",
    )

    if root.get("schema_version") != SCHEMA_VERSION:
        raise RequestError(
            f"schema_version must be {SCHEMA_VERSION}, got {root.get('schema_version')!r}"
        )

    case = text_value(root.get("case"), "case")
    identity_raw = mapping_value(root.get("identity"), "identity")
    reject_unknown_keys(identity_raw, set(IDENTITY_FIELDS), "identity")

    notes_raw = root.get("identity_notes") or {}
    notes_raw = mapping_value(notes_raw, "identity_notes")
    reject_unknown_keys(notes_raw, set(IDENTITY_FIELDS), "identity_notes")

    effects_raw = mapping_value(root.get("identity_effects"), "identity_effects")
    reject_unknown_keys(effects_raw, set(IDENTITY_FIELDS), "identity_effects")

    identity: dict[str, str] = {}
    notes: dict[str, str] = {}
    effects: dict[str, str] = {}
    for field in IDENTITY_FIELDS:
        value = text_value(identity_raw.get(field), f"identity.{field}")
        marker = normalized_marker(value)
        if marker in UNKNOWN_VALUES:
            raise RequestError(
                f"identity.{field} is unresolved ({value!r}); provide a value or N/A with a reason"
            )
        if field in notes_raw:
            notes[field] = text_value(notes_raw[field], f"identity_notes.{field}")
        if marker in NOT_APPLICABLE_VALUES and field not in notes:
            raise RequestError(
                f"identity.{field} is N/A but identity_notes.{field} has no reason"
            )
        identity[field] = value
        effects[field] = text_value(
            effects_raw.get(field), f"identity_effects.{field}"
        )

    compile_raw = mapping_value(root.get("compile"), "compile")
    reject_unknown_keys(compile_raw, {"target", "steps"}, "compile")
    target = text_value(compile_raw.get("target"), "compile.target")
    steps_raw = compile_raw.get("steps")
    if not isinstance(steps_raw, list) or not steps_raw:
        raise RequestError("compile.steps must be a non-empty list")

    steps: list[dict[str, Any]] = []
    for index, raw_step in enumerate(steps_raw, start=1):
        label = f"compile.steps[{index}]"
        step = mapping_value(raw_step, label)
        reject_unknown_keys(step, {"name", "cwd", "env", "command"}, label)
        name = text_value(step.get("name") or f"step-{index}", f"{label}.name")

        cwd_text = text_value(step.get("cwd"), f"{label}.cwd")
        cwd = Path(cwd_text).expanduser()
        if not cwd.is_absolute():
            raise RequestError(f"{label}.cwd must be an absolute path")
        if not cwd.is_dir():
            raise RequestError(f"{label}.cwd is not an existing directory: {cwd}")
        cwd = cwd.resolve()

        env_raw = step.get("env") or {}
        env_raw = mapping_value(env_raw, f"{label}.env")
        env: dict[str, str] = {}
        for key, raw_value in env_raw.items():
            if not isinstance(key, str) or not ENV_NAME_RE.fullmatch(key):
                raise RequestError(f"{label}.env has invalid variable name: {key!r}")
            if not isinstance(raw_value, (str, int, float)):
                raise RequestError(f"{label}.env.{key} must be a string or number")
            env[key] = str(raw_value)

        command = text_value(step.get("command"), f"{label}.command")
        steps.append(
            {
                "name": name,
                "cwd": str(cwd),
                "env": env,
                "command": command,
            }
        )

    return {
        "schema_version": SCHEMA_VERSION,
        "case": case,
        "identity": identity,
        "identity_notes": notes,
        "identity_effects": effects,
        "compile": {
            "target": target,
            "steps": steps,
        },
    }


def load_request(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise RequestError(f"request file not found: {path}")
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle)
    except (OSError, yaml.YAMLError) as exc:
        raise RequestError(f"cannot read request {path}: {exc}") from exc
    return normalize_request(data)


def request_hash(request: dict[str, Any]) -> str:
    payload = json.dumps(
        request,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return "sha256:" + hashlib.sha256(payload).hexdigest()


def render_report(request: dict[str, Any]) -> str:
    lines = [
        "[编译前置声明]",
        "",
        f"Case：{request['case']}",
        f"编译对象：{request['compile']['target']}",
    ]
    identity = request["identity"]
    notes = request["identity_notes"]
    effects = request["identity_effects"]
    for field in IDENTITY_FIELDS:
        suffix = f"（{notes[field]}）" if field in notes else ""
        lines.append(f"{IDENTITY_LABELS[field]}：{identity[field]}{suffix}")

    lines.extend(["", "身份对编译的影响："])
    for field in IDENTITY_FIELDS:
        lines.append(f"- {IDENTITY_LABELS[field]} -> {effects[field]}")

    lines.extend(["", "原始编译命令："])
    for index, step in enumerate(request["compile"]["steps"], start=1):
        lines.append(f"{index}. {step['name']}")
        lines.append(f"   工作目录：{step['cwd']}")
        if step["env"]:
            rendered_env = " ".join(
                f"{key}={shlex.quote(value)}" for key, value in step["env"].items()
            )
            lines.append(f"   环境变量：{rendered_env}")
        else:
            lines.append("   环境变量：无")
        lines.append(f"   $ {step['command']}")

    plan_hash = request_hash(request)
    lines.extend(["", f"Plan hash：{plan_hash}", "Decision：READY"])
    return "\n".join(lines)


def normalize_plan_hash(value: str) -> str:
    value = value.strip().lower()
    if re.fullmatch(r"[0-9a-f]{64}", value):
        return "sha256:" + value
    if re.fullmatch(r"sha256:[0-9a-f]{64}", value):
        return value
    raise RequestError("plan hash must be a SHA-256 hex digest, with optional sha256: prefix")


def execute_request(request: dict[str, Any]) -> int:
    for index, step in enumerate(request["compile"]["steps"], start=1):
        print(f"\n[执行 {index}/{len(request['compile']['steps'])}] {step['name']}", flush=True)
        env = os.environ.copy()
        env.update(step["env"])
        result = subprocess.run(
            ["/bin/bash", "-lc", step["command"]],
            cwd=step["cwd"],
            env=env,
            check=False,
        )
        if result.returncode != 0:
            print(
                f"compile-tool: step failed with exit code {result.returncode}: {step['name']}",
                file=sys.stderr,
            )
            return result.returncode
    print("\ncompile-tool: all compile steps completed")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Validate, display, bind, and execute explicit compile commands"
    )
    parser.add_argument("--version", action="version", version="compile-tool 1.0")
    subparsers = parser.add_subparsers(dest="command", required=True)

    prepare = subparsers.add_parser(
        "prepare", help="validate and display a compile request without executing it"
    )
    prepare.add_argument("request", type=Path)

    run = subparsers.add_parser(
        "run", help="execute a previously displayed and hash-bound compile request"
    )
    run.add_argument("request", type=Path)
    run.add_argument("--plan-hash", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        request = load_request(args.request)
        if args.command == "prepare":
            print(render_report(request))
            return 0

        expected_hash = request_hash(request)
        supplied_hash = normalize_plan_hash(args.plan_hash)
        if supplied_hash != expected_hash:
            raise RequestError(
                "plan hash mismatch; run prepare again and show the updated command before execution"
            )
        print(render_report(request), flush=True)
        print("\nExecution：STARTING", flush=True)
        return execute_request(request)
    except RequestError as exc:
        print(f"compile-tool: BLOCKED: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
